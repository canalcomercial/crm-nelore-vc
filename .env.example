# Copie para .env e preencha com os dados do seu projeto Supabase.
# Supabase → Project Settings → Data API (URL) e API Keys (publishable key).
VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Domínio público usado em links de contrato, formulários e página comercial.
# Ex.: https://crm.nelorevc.com.br — deixe vazio para usar a origem atual do navegador.
VITE_PUBLIC_SITE_URL=""

# Somente para migrations via drizzle-kit (não usado pelo app no browser).
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL="postgresql://postgres:[SENHA]@db.seu-project-ref.supabase.co:5432/postgres"
